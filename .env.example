# Copy this to .env and fill in the real values.
# .env is git-ignored.

# -------- Zoho Mail (IMAP) --------
# Generate an app-specific password in Zoho: Account -> Security -> App Passwords
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=xxxxxxxxxxxxxxxx
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993

# -------- Zoho Calendar (CalDAV) --------
# CalDAV endpoint is typically https://calendar.zoho.com/caldav for @zoho, or
# https://calendar.zoho.<region>/caldav for regional accounts (.eu, .in, .com.au).
ZOHO_CALDAV_URL=https://calendar.zoho.com/caldav
ZOHO_CALDAV_USER=you@yourdomain.com
ZOHO_CALDAV_PASSWORD=xxxxxxxxxxxxxxxx

# -------- PM tool (MySQL) --------
PM_DB_HOST=localhost
PM_DB_PORT=3306
PM_DB_USER=eod_reader
PM_DB_PASSWORD=change_me
PM_DB_NAME=projects

# -------- Anthropic --------
ANTHROPIC_API_KEY=sk-ant-...

# -------- Preferences --------
# IANA timezone name for calendar rendering
TZ=America/New_York
# Full name and role hint for the LLM
USER_NAME=Mark
USER_ROLE=Founder / eCommerce operator
