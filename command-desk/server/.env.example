# ---- Login (required) ----
# Generate with:  npm run hash-password -- 'your password'
DASH_PASSWORD_HASH=
# 32+ random characters, e.g. from:  openssl rand -hex 32
SESSION_SECRET=

# ---- Schedule ----
TIMEZONE=Asia/Kolkata
WORK_HOURS=7-21
REFRESH_MINUTES=60

# ---- Claude (plans + reply drafts) ----
ANTHROPIC_API_KEY=
# Optional: claude-sonnet-5-5 costs about half as much per run
# CLAUDE_MODEL=claude-opus-5-5

# ---- Zoho Mail (Self Client in https://api-console.zoho.in) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_HOST=https://accounts.zoho.in
# ZOHO_MAIL_API=https://mail.zoho.in/api

# ---- Slack (user token, xoxp-..., scopes: search:read chat:write users:read) ----
SLACK_USER_TOKEN=

# ---- Monday.com: one personal API token per account. First account = your main one. ----
MONDAY_ACCOUNTS=[{"label":"VenueScale","token":"","boards":[5024056553]},{"label":"Mood Creative","token":""},{"label":"The Great Escape","token":""}]

# Where handled items and plans are saved (point at a persistent disk in production)
DATA_DIR=./data
